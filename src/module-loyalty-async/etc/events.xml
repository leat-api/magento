<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="newsletter_subscriber_save_commit_after">
        <observer name="leat_loyalty_newsletter_subscription_save"
                  instance="Leat\LoyaltyAsync\Observer\Newsletter\SubscriptionUpdate"/>
    </event>
    <event name="newsletter_subscriber_delete_commit_after">
        <observer name="leat_loyalty_newsletter_subscription_delete"
                  instance="Leat\LoyaltyAsync\Observer\Newsletter\SubscriptionUpdate"/>
    </event>
</config>
