<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Customer:etc/sections.xsd">
    <!-- Invalidate Leat section when a reward is redeemed -->
    <action name="leat/reward/redeem">
        <section name="leat"/>
        <section name="cart"/>
    </action>

    <!-- Invalidate Leat section (balance, activity log) when earn points are claimed -->
    <action name="leat/earnpoints/claim">
        <section name="leat"/>
    </action>

    <!-- Invalidate Leat section when a coupon is collected/applied -->
    <action name="leat/coupon/collect">
        <section name="leat"/>
        <section name="cart"/>
    </action>

    <!-- Invalidate Leat section when a coupon is removed -->
    <action name="leat/coupon/remove">
        <section name="leat"/>
        <section name="cart"/>
    </action>

    <!-- Removing a gift line or emptying the cart unapplies vouchers, which changes the Leat voucher list -->
    <action name="checkout/cart/delete">
        <section name="leat"/>
    </action>
    <action name="checkout/cart/updatePost">
        <section name="leat"/>
    </action>
    <action name="checkout/sidebar/removeItem">
        <section name="leat"/>
    </action>

    <action name="rest/*/V1/carts/*/payment-information">
        <section name="leat"/>
    </action>

    <action name="checkout/onepage/saveOrder">
        <section name="leat"/>
    </action>

    <action name="customer/ajax/login">
        <section name="leat"/>
    </action>
</config>
