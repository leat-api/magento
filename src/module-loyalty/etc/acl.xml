<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <!-- One main category for everything Leat. Declared in every Leat module that adds resources (same
                     id and title, Magento merges them), so each module also works without the others. -->
                <resource id="Leat_Loyalty::leat" title="Leat Loyalty" sortOrder="11">
                    <resource id="Leat_Loyalty::config" title="Configuration" sortOrder="10"/>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
