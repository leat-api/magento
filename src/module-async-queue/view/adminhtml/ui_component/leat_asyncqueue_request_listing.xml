<?xml version="1.0" encoding="UTF-8"?>
<!-- Not a page of its own: embedded in the job form, filtered on the job it is shown in. -->
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">leat_asyncqueue_request_listing.leat_asyncqueue_request_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>leat_asyncqueue_request_columns</spinner>
        <deps>
            <dep>leat_asyncqueue_request_listing.leat_asyncqueue_request_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="leat_asyncqueue_request_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <filterUrlParams>
                <param name="job_id">*</param>
            </filterUrlParams>
            <storageConfig>
                <param name="indexField" xsi:type="string">request_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Leat_AsyncQueue::jobs</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="leat_asyncqueue_request_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>request_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="leat_asyncqueue_request_columns">
        <settings>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">leat_asyncqueue_request_listing.leat_asyncqueue_request_listing.leat_asyncqueue_request_columns.actions</item>
                    <item name="target" xsi:type="string">applyAction</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">edit</item>
                        <item name="1" xsi:type="string">${ $.$data.rowIndex }</item>
                    </item>
                </param>
            </childDefaults>
        </settings>
        <column name="request_id" sortOrder="20">
            <settings>
                <label translate="true">Request ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="type_code" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Type</label>
            </settings>
        </column>
        <column name="status" class="Leat\AsyncQueue\Ui\Component\Listing\Column\Status" sortOrder="40">
            <settings>
                <options class="Leat\AsyncQueue\Model\RequestStatus"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="attempt" sortOrder="50">
            <settings>
                <label translate="true">Attempts</label>
            </settings>
        </column>
        <column name="fail_summary" sortOrder="60">
            <settings>
                <filter>text</filter>
                <label translate="true">Latest failure</label>
            </settings>
        </column>
        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="70">
            <settings>
                <dataType>date</dataType>
                <label translate="true">Updated</label>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="80">
            <settings>
                <dataType>date</dataType>
                <label translate="true">Created</label>
                <visible>false</visible>
            </settings>
        </column>
        <actionsColumn name="actions" class="Leat\AsyncQueue\Ui\Component\Listing\Column\RequestActions" sortOrder="200">
            <settings>
                <indexField>request_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
