<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">leat_asyncqueue_request_form.leat_asyncqueue_request_form_data_source</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="Leat\AsyncQueue\Ui\Component\Form\Button\Back"/>
            <button name="retry" class="Leat\AsyncQueue\Ui\Component\Form\Button\Retry"/>
            <button name="more" class="Leat\AsyncQueue\Ui\Component\Form\Button\MoreActions"/>
            <button name="save" class="Leat\AsyncQueue\Ui\Component\Form\Button\Save"/>
        </buttons>
        <namespace>leat_asyncqueue_request_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>leat_asyncqueue_request_form.leat_asyncqueue_request_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="leat_asyncqueue_request_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="leat_asyncqueue/request/save"/>
        </settings>
        <aclResource>Leat_AsyncQueue::jobs</aclResource>
        <dataProvider class="Leat\AsyncQueue\Ui\DataProvider\RequestForm" name="leat_asyncqueue_request_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>request_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label translate="true">Request</label>
            <collapsible>false</collapsible>
        </settings>
        <field name="request_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>request_id</dataScope>
            </settings>
        </field>
        <field name="job_id_display" formElement="input" sortOrder="10">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Job</label>
                <dataScope>job_id</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="type_code" formElement="input" sortOrder="20">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Type</label>
                <dataScope>type_code</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="status" formElement="input" sortOrder="30">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Status</label>
                <dataScope>status</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="attempt" formElement="input" sortOrder="40">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Attempts</label>
                <dataScope>attempt</dataScope>
                <notice translate="true">Requests stop being retried at 9 attempts. Set to 0 to have the cron pick the request up again.</notice>
                <validation>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                </validation>
                <imports>
                    <link name="disabled">${ $.provider }:data.lock_manage</link>
                </imports>
            </settings>
        </field>
        <field name="is_synced" formElement="checkbox" sortOrder="50">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">request</item>
                </item>
            </argument>
            <settings>
                <dataType>boolean</dataType>
                <label translate="true">Synced</label>
                <dataScope>is_synced</dataScope>
                <notice translate="true">Marking a request as synced skips it without sending it to Leat. Requires the permission to mark requests as synced.</notice>
                <imports>
                    <link name="disabled">${ $.provider }:data.lock_sync</link>
                </imports>
            </settings>
            <formElements>
                <checkbox>
                    <settings>
                        <valueMap>
                            <map name="false" xsi:type="string">0</map>
                            <map name="true" xsi:type="string">1</map>
                        </valueMap>
                        <prefer>toggle</prefer>
                    </settings>
                </checkbox>
            </formElements>
        </field>
        <field name="created_at" formElement="input" sortOrder="60">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Created</label>
                <dataScope>created_at</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="updated_at" formElement="input" sortOrder="70">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Updated</label>
                <dataScope>updated_at</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>
    </fieldset>
    <fieldset name="content">
        <settings>
            <label translate="true">Payload and outcome</label>
            <collapsible>false</collapsible>
        </settings>
        <field name="payload" formElement="textarea" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="rows" xsi:type="number">18</item>
                    <item name="elementTmpl" xsi:type="string">ui/form/element/textarea</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Payload (JSON)</label>
                <dataScope>payload</dataScope>
                <notice translate="true">Must be valid JSON, it is checked before saving. Editing needs its own permission.</notice>
                <imports>
                    <link name="disabled">${ $.provider }:data.lock_payload</link>
                </imports>
            </settings>
        </field>
        <field name="result" formElement="textarea" sortOrder="20">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="rows" xsi:type="number">10</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Result</label>
                <dataScope>result</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="latest_fail_reason" formElement="textarea" sortOrder="30">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="rows" xsi:type="number">14</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Latest failure</label>
                <dataScope>latest_fail_reason</dataScope>
                <disabled>true</disabled>
            </settings>
        </field>
    </fieldset>
</form>
