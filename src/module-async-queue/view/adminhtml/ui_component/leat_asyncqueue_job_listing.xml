<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">leat_asyncqueue_job_listing.leat_asyncqueue_job_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>leat_asyncqueue_job_columns</spinner>
        <deps>
            <dep>leat_asyncqueue_job_listing.leat_asyncqueue_job_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="leat_asyncqueue_job_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <!-- ?attention=1 (menu: "Needs attention") only lists jobs with failing requests -->
            <filterUrlParams>
                <param name="attention">*</param>
                <!-- the exhausted requests banner links here -->
                <param name="needs_intervention">*</param>
                <!-- the customer view lists the jobs of one customer -->
                <param name="relation_id">*</param>
            </filterUrlParams>
            <storageConfig>
                <param name="indexField" xsi:type="string">job_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Leat_AsyncQueue::jobs</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="leat_asyncqueue_job_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>job_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="leat_asyncqueue_job_columns">
        <settings>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">leat_asyncqueue_job_listing.leat_asyncqueue_job_listing.leat_asyncqueue_job_columns.actions</item>
                    <item name="target" xsi:type="string">applyAction</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">edit</item>
                        <item name="1" xsi:type="string">${ $.$data.rowIndex }</item>
                    </item>
                </param>
            </childDefaults>
        </settings>
        <column name="job_id" sortOrder="20">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Job ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="customer" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Customer</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="relation_id" sortOrder="35">
            <settings>
                <filter>text</filter>
                <label translate="true">Relation ID</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="source_id" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">Source</label>
            </settings>
        </column>
        <column name="store_id" sortOrder="45">
            <settings>
                <filter>text</filter>
                <label translate="true">Store ID</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="request_count" sortOrder="50">
            <settings>
                <label translate="true">Requests</label>
            </settings>
        </column>
        <column name="synced_count" sortOrder="55">
            <settings>
                <label translate="true">Synced</label>
            </settings>
        </column>
        <column name="max_attempt" sortOrder="60">
            <settings>
                <label translate="true">Highest attempt</label>
            </settings>
        </column>
        <column name="has_failures" class="Leat\AsyncQueue\Ui\Component\Listing\Column\FailureFlag" sortOrder="65">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <label translate="true">Has failures</label>
            </settings>
        </column>
        <column name="needs_intervention" class="Leat\AsyncQueue\Ui\Component\Listing\Column\FailureFlag" sortOrder="70">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <label translate="true">Needs admin intervention</label>
            </settings>
        </column>
        <column name="is_blocked" class="Leat\AsyncQueue\Ui\Component\Listing\Column\FailureFlag" sortOrder="72">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <label translate="true">Blocked</label>
            </settings>
        </column>
        <column name="blocked_by" sortOrder="75">
            <settings>
                <label translate="true">Blocked by job</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="completed" component="Magento_Ui/js/grid/columns/select" sortOrder="80">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Completed</label>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="90">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Created</label>
            </settings>
        </column>
        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="95">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Updated</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Leat\AsyncQueue\Ui\Component\Listing\Column\JobActions" sortOrder="200">
            <settings>
                <indexField>job_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
